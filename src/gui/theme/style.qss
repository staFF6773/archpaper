/* Neutral dark surfaces. Keep child widgets transparent to avoid label boxes. */
QWidget {
    background: transparent;
    color: #eeeeee;
    font-family: 'Inter', 'Noto Sans', 'Segoe UI', sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog, QMessageBox {
    background: #121212;
}

QLabel { border: none; }
QLabel:disabled { color: #707070; }

/* Navigation */
#navSidebar {
    background: #161616;
    border-right: 1px solid #262626;
}

#sidebarTitle {
    font-size: 16px;
    font-weight: 600;
    padding: 0 8px 6px;
}

#sidebarSectionTitle {
    color: #909090;
    font-size: 10px;
    font-weight: 600;
    padding-left: 8px;
}

#sidebarSeparator {
    background: #262626;
    border: none;
}

QPushButton[navButton="true"] {
    background: transparent;
    color: #a6a6a6;
    text-align: left;
    font-weight: 400;
    padding: 6px 10px;
    min-height: 20px;
    border: 1px solid transparent;
    border-radius: 6px;
}

QPushButton[navButton="true"]:hover {
    background: #222222;
    color: #eeeeee;
}

QPushButton[navButton="true"]:checked {
    background: #2a2a2a;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#sidebarSmallButton {
    background: transparent;
    color: #a6a6a6;
    padding: 0;
    min-height: 0;
    border: 1px solid transparent;
    border-radius: 4px;
}

QPushButton#sidebarSmallButton:hover { background: #2a2a2a; color: #ffffff; }

#folderList {
    border: none;
    outline: none;
    padding: 4px 0;
}

#folderList::item {
    color: #a6a6a6;
    padding: 6px 8px;
    margin: 1px 0;
    border: 1px solid transparent;
    border-radius: 5px;
}

#folderList::item:selected { background: #262626; color: #eeeeee; }
#folderList::item:hover:!selected { background: #202020; }
#folderList::item:focus { border-color: #777777; }

/* Header and controls */
#toolbar { border: none; }
#panelTitle { font-size: 18px; font-weight: 600; }
#panelHeader { font-size: 12px; font-weight: 600; color: #c5c5c5; }
#mutedLabel, #infoLabel, #statusLabel { color: #999999; font-size: 12px; }

QLineEdit, QComboBox, QSpinBox {
    background: #1c1c1c;
    color: #dddddd;
    border: 1px solid #303030;
    border-radius: 5px;
    padding: 5px 8px;
    min-height: 20px;
    selection-background-color: #4a4a4a;
    selection-color: #ffffff;
}

QLineEdit:hover, QComboBox:hover, QSpinBox:hover { border-color: #454545; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border-color: #999999; }
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled { color: #707070; }
QComboBox { padding-right: 24px; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox::down-arrow { image: url(:/theme/chevron-down.xpm); width: 10px; height: 6px; }
QSpinBox { padding-right: 24px; }
QSpinBox::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 22px; border: none; }
QSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 22px; border: none; }
QSpinBox::up-arrow { image: url(:/theme/chevron-up.xpm); width: 10px; height: 6px; }
QSpinBox::down-arrow { image: url(:/theme/chevron-down.xpm); width: 10px; height: 6px; }
QComboBox QAbstractItemView {
    background: #202020;
    color: #eeeeee;
    border: 1px solid #3a3a3a;
    selection-background-color: #383838;
    selection-color: #ffffff;
    outline: none;
    padding: 4px;
}

QPushButton, QToolButton {
    background: #202020;
    color: #cccccc;
    border: 1px solid #303030;
    border-radius: 5px;
    padding: 5px 10px;
    min-height: 20px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton:hover, QToolButton:hover { background: #2c2c2c; color: #ffffff; border-color: #454545; }
QPushButton:pressed, QToolButton:pressed { background: #353535; }
QPushButton:checked { background: #343434; color: #ffffff; border-color: #555555; }
QPushButton#primaryButton { background: #e5e5e5; color: #171717; border-color: #e5e5e5; font-weight: 600; }
QPushButton#primaryButton:hover { background: #ffffff; border-color: #ffffff; }
QPushButton#primaryButton:pressed { background: #c5c5c5; border-color: #c5c5c5; }
QPushButton#favoriteToolButton { padding: 0; min-height: 0; font-size: 17px; }
QPushButton:focus, QToolButton:focus, QPushButton[navButton="true"]:focus,
QPushButton#sidebarSmallButton:focus, QPushButton#favoriteToolButton:focus { border-color: #aaaaaa; }
QPushButton#primaryButton:focus { border-color: #777777; }
QPushButton:disabled, QToolButton:disabled, QPushButton#primaryButton:disabled,
QPushButton#favoriteToolButton:disabled { background: #1c1c1c; color: #707070; border-color: #292929; }

QToolButton::menu-indicator { subcontrol-position: right center; right: 4px; }
QToolButton { padding-right: 16px; }
QMenu { background: #202020; border: 1px solid #3a3a3a; padding: 4px; }
QMenu::item { padding: 7px 20px 7px 12px; border-radius: 4px; }
QMenu::item:selected { background: #363636; }
QMenu::separator { height: 1px; background: #333333; margin: 4px; }

QCheckBox { spacing: 8px; padding: 3px 0; }
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #555555;
    border-radius: 3px;
    background: #202020;
}
QCheckBox::indicator:hover { border-color: #aaaaaa; }
QCheckBox::indicator:checked { background: #dddddd; border-color: #dddddd; image: url(:/theme/check.xpm); }
QCheckBox:focus { color: #ffffff; background: #292929; border-radius: 4px; }

/* Library */
#wallpaperGrid, #imagesList { background: transparent; border: none; }
#imagesList { outline: none; padding: 0; }
#imagesList::item {
    background: #191919;
    color: #b5b5b5;
    border: 1px solid #282828;
    border-radius: 7px;
    padding: 4px;
    margin: 3px;
    font-size: 12px;
}
#imagesList::item:hover { background: #232323; border-color: #484848; }
#imagesList::item:selected { background: #303030; border-color: #858585; color: #ffffff; }
#imagesList::item:focus { border-color: #dddddd; }
#emptyState { color: #999999; padding: 20px; }

#previewPanel {
    background: #191919;
    border: 1px solid #2a2a2a;
    border-radius: 7px;
}
#previewImage, #previewVideo { background: #151515; color: #999999; border-radius: 6px; }

/* Settings and footer */
QGroupBox#settingsGroup {
    background: #191919;
    border: 1px solid #2a2a2a;
    border-radius: 6px;
    margin-top: 9px;
    padding: 12px 10px 8px;
    font-weight: 600;
}
QGroupBox#settingsGroup::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 5px;
}
#statusBar { border: none; border-top: 1px solid #262626; }
QScrollArea { border: none; }
QSplitter::handle { background: transparent; }
QSplitter::handle:hover { background: #383838; border-radius: 3px; }

QScrollBar:vertical { background: transparent; width: 8px; margin: 0; }
QScrollBar:horizontal { background: transparent; height: 8px; margin: 0; }
QScrollBar::handle { background: #3a3a3a; border-radius: 4px; }
QScrollBar::handle:vertical { min-height: 28px; }
QScrollBar::handle:horizontal { min-width: 28px; }
QScrollBar::handle:hover { background: #5a5a5a; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QToolTip { background: #292929; color: #eeeeee; border: 1px solid #484848; padding: 5px 8px; }
